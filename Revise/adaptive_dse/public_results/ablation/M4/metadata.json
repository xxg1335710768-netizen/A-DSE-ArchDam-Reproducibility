{
  "method": "M4",
  "change": "no_accuracy_trigger",
  "seed": 2025,
  "initial_samples": 80,
  "early_stopping_validation_samples": 16,
  "outer_iterations": 30,
  "objectives": ["V_dam", "S_t"],
  "accuracy_gate": {"enabled": false, "rms_relative_error_limit": 0.01},
  "active_learning": {"mode": "weighted_joint_uncertainty", "batch_size": 3, "duplicate_distance": 1e-8, "diversity_distance": 0.025},
  "nsga2": {"population_size": 100, "generations": 100},
  "bounds_update": {"mode": "importance", "gamma": 0.4, "eta_start": 0.15, "eta_end": 0.03, "reference_span_ratio": 0.1},
  "signed_stress_interval_mpa": [-1.5, 9.78],
  "dataset": "Revise/dataset/SurrogateDataset.xlsx",
  "surrogate_checkpoint": "Revise/surrogate_benchmark/results/seed_2025/ensemble_mmoe/fitted_model.pt"
}
